@Orders.Api_HostAddress = http://localhost:5198

GET {{Orders.Api_HostAddress}}/health
Accept: application/json

### Create order
POST {{Orders.Api_HostAddress}}/orders
Content-Type: application/json

{
  "customerName": "Jan Kowalski",
  "items": [
    { "productName": "Widget", "quantity": 2, "unitPrice": 19.99 }
  ]
}

### Create order - invalid (validation should fail)
POST {{Orders.Api_HostAddress}}/orders
Content-Type: application/json

{
  "customerName": "",
  "items": [
    { "productName": "Widget", "quantity": -1, "unitPrice": 0 }
  ]
}

### Get order by id
GET {{Orders.Api_HostAddress}}/orders/{{orderId}}
Accept: application/json

### Get non-existent order
GET {{Orders.Api_HostAddress}}/orders/00000000-0000-0000-0000-000000000000
Accept: application/json

### Get all orders
GET {{Orders.Api_HostAddress}}/orders
Accept: application/json

###